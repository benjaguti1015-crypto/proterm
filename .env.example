# Copia este archivo como .env.local para correr en tu computador.
# En Vercel se cargan en Settings > Environment Variables.

# Supabase: Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase: Project Settings > API Keys > service_role (o la "secret key" sb_secret_...)
# Es secreta: da acceso total a la base de datos. Nunca la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Texto largo al azar para firmar la cookie de sesión.
# Se puede generar con: openssl rand -base64 32
SESSION_SECRET=

# Solo para generar los QR (npm run qr). No hace falta en Vercel.
BASE_URL=https://tu-app.vercel.app
